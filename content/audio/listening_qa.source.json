{
  "version": 3,
  "status": "source-ready-expanded-acquired-review",
  "owner": "ChatGPT",
  "runtimeOwner": "Claude",
  "input": "PrivateContent/AudioSourceIncoming/acquisition_manifest.json",
  "inputs": [
    "content/audio/acquisition_receipt.source.json",
    "content/audio/acquisition_extension_receipt.source.json",
    "content/audio/acquisition_extension_member_shortlist.source.json",
    "content/audio/acquisition_field_backlog_receipt.source.json",
    "content/audio/listening_review_targets.source.json",
    "content/audio/pr6_environment_artifact_audit.source.json"
  ],
  "states": [
    "candidate",
    "acquired-original-not-listening-approved",
    "listening-rejected",
    "source-approved",
    "derived-master-approved",
    "Unity-integrated",
    "release-approved"
  ],
  "reviewDecisionValues": ["keep", "maybe", "reject"],
  "fieldBacklogDispositionValues": ["unreviewed", "candidate-pass", "reject", "needs-more-listening"],
  "reviewDecisionRule": "keep/maybe/reject and candidate-pass/reject/needs-more-listening are source-selection notes only. Only a completed pass through sourceApprovedRequires may change a source to source-approved.",
  "reviewEvidence": {
    "schemaVersion": 3,
    "normalizer": "tools/normalize_audio_human_review.py",
    "fieldBacklogNormalizer": "tools/normalize_audio_field_backlog_review.py",
    "ci": ".github/workflows/audio-human-review-validation.yml",
    "fieldBacklogCi": ".github/workflows/audio-field-human-review-validation.yml",
    "acceptedExportStatuses": [
      "human-listening-review-unvalidated",
      "human-review-not-canonical-approval",
      "human-field-backlog-review-unvalidated"
    ],
    "normalizedStatus": "human-review-evidence-unapproved",
    "requireHashBindings": true,
    "rule": "Only reviewer exports with SHA-256 bindings matching committed receipts/shortlists are valid evidence input. Normalization never promotes source approval."
  },
  "reviewGroups": [
    {
      "id": "MAIN_ACQUIRED_ORIGINALS",
      "targets": ["AMB_WIND_WORLD", "AMB_RAIN_ALT", "SFX_FIRE_ALT"],
      "focus": ["contamination", "space identity", "material/context fit", "loop/edit usefulness", "speech masking"]
    },
    {
      "id": "OCEAN_EXTENSION",
      "targets": ["AMB_OCEAN_ALT"],
      "focus": ["wave character", "edit usefulness", "short-source loop risk", "48 kHz derivation need"]
    },
    {
      "id": "WOOD_EXTENSION",
      "targets": ["SFX_WOOD_PACK_ALT"],
      "members": ["floor_creak1.wav", "floor_creak2.wav", "floor_creak3.wav", "door_creak_open.wav", "door_creak_close.wav"],
      "focus": ["shelter-timber fit", "obvious floor/door identity", "transient quality", "variation value"]
    },
    {
      "id": "CLOTH_EXTENSION",
      "targets": ["SFX_CLOTH_PACK_ALT"],
      "members": ["OGG/cloth1.ogg", "OGG/cloth2.ogg", "OGG/cloth3.ogg", "OGG/cloth4.ogg", "OGG/clothBelt.ogg", "OGG/clothBelt2.ogg", "OGG/creak1.ogg", "OGG/creak2.ogg", "OGG/creak3.ogg"],
      "focus": ["tarp/cloth material scale", "synthetic/game-SFX character", "tension usefulness", "lossy-source handling"]
    },
    {
      "id": "FIELD_BACKLOG_NIGHT_INSECT",
      "targets": ["SFX_NAT_NIGHT_CRICKET_ALT_01"],
      "runtimeEventCandidates": ["SFX_NAT_Insect_NightChirp"],
      "template": "content/audio/field_backlog_human_review.template.json",
      "guide": "docs/66_AUDIO_FIELD_BACKLOG_HUMAN_REVIEW.md",
      "focus": ["laptop-mic/handling contamination", "island night biome fit", "outdoor space identity", "noise floor after realistic gain", "distinct chirp-cluster variation", "speech space", "44.1 kHz derivation need"]
    },
    {
      "id": "PR6_ENVIRONMENT_CANDIDATES",
      "source": "content/audio/pr6_environment_artifact_audit.source.json",
      "focus": ["seam risk", "source reuse", "perspective differentiation", "fire idle/low differentiation", "wind space identity"]
    }
  ],
  "requiredListeningChecks": [
    {"id":"CONTAMINATION","question":"Voices, traffic, birds, room tone, handling noise or unrelated events that conflict with the island context?","result":"pass/fail + note"},
    {"id":"MATERIAL_MATCH","question":"Does the sound read as the intended material/action/biome at normal level without relying on filename knowledge?","result":"1-5 + note"},
    {"id":"LOOP_OR_SLICE","question":"Can useful loop regions or clean one-shots be derived without obvious repeated artifacts?","result":"pass/fail/not-applicable + note"},
    {"id":"NOISE_FLOOR","question":"Is noise/hiss acceptable for the intended use after normal game gain staging?","result":"pass/fail + note"},
    {"id":"TRANSIENT_QUALITY","question":"Are important transients unclipped and useful for editing?","result":"pass/fail/not-applicable + note"},
    {"id":"SPACE_IDENTITY","question":"Does the recording contain obvious indoor/outdoor or distance character that conflicts with intended use?","result":"pass/fail + note"},
    {"id":"VARIATION_VALUE","question":"Does this source provide enough distinct material for non-repeating variants or layering?","result":"1-5 + note"},
    {"id":"SPEECH_SPACE","question":"For loops/beds, is there avoidable dense midrange energy likely to mask partner/radio speech?","result":"pass/fail/not-applicable + note"}
  ],
  "technicalChecks": [
    "record actual codec/sample rate/channels/bit depth from technicalProbe",
    "preserve source SHA-256",
    "do not overwrite the acquired original",
    "record every edit/resample operation used for a derived master",
    "preserve selected archive member SHA-256 before any extraction-derived edit",
    "avoid repeated lossy transcodes when a selected source member is Vorbis/OGG",
    "for 44.1 kHz approved originals create a documented derived 48 kHz master where appropriate and repeat listening QA"
  ],
  "approvalRule": {
    "sourceApprovedRequires": ["license evidence preserved", "SHA-256 preserved", "all applicable required listening checks completed", "no unresolved contamination failure", "material match >= 3"],
    "derivedMasterApprovedRequires": ["source-approved original", "edit recipe documented", "48 kHz/24-bit WAV target where appropriate", "no clipping", "listening QA repeated on derived file"]
  },
  "runtimeBoundary": "Claude owns final Unity mix, spatialization, ducking, compression/import settings and device listening QA."
}
