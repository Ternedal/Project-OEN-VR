{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-oen.local/schemas/scenario.schema.json",
  "title": "ScenarioDefinition",
  "type": "object",
  "required": ["id", "version", "playerCount", "phases", "initialState", "winRules", "loseRules"],
  "properties": {
    "id": {"type": "string", "pattern": "^SCN_[A-Z0-9_]+_[0-9]{3}$"},
    "version": {"type": "integer", "minimum": 1},
    "playerCount": {"const": 2},
    "displayKey": {"type": "string"},
    "seedPolicy": {"enum": ["fixed", "random", "host-selected"]},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "checkpoint": {"type": "boolean"},
          "actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "initialState": {"type": "object"},
    "eventPools": {"type": "array", "items": {"type": "string"}},
    "winRules": {"type": "array", "items": {"type": "object"}},
    "loseRules": {"type": "array", "items": {"type": "object"}},
    "personalizationHooks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
