{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-oen.local/schemas/scenario.schema.json",
  "title": "ScenarioDefinition",
  "type": "object",
  "required": [
    "id",
    "version",
    "playerCount",
    "phases",
    "initialState",
    "winRules",
    "loseRules",
    "supportedBuildProtocol",
    "actionCatalog",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SCN_[A-Z0-9_]+_[0-9]{3}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "playerCount": {
      "const": 2
    },
    "displayKey": {
      "type": "string"
    },
    "seedPolicy": {
      "enum": [
        "fixed",
        "random",
        "host-selected"
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "checkpoint": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "initialState": {
      "type": "object"
    },
    "eventPools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "winRules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "loseRules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "personalizationHooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportedBuildProtocol": {
      "type": "integer",
      "minimum": 1,
      "description": "NetworkProtocolVersion som dette scenario kraever. Indgaar i compatibility handshake, jf. docs/07 afsnit 5."
    },
    "contentVersion": {
      "type": "string",
      "description": "Content-version der indgaar i handshake-hashen."
    },
    "actionCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "effortCost",
          "primaryRole",
          "secondaryRole"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INT_[A-Z0-9_]+_[0-9]{3}$"
          },
          "effortCost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "primaryRole": {
            "type": "string"
          },
          "secondaryRole": {
            "type": "string"
          },
          "unlockedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "description": "actionId -> udfaldstier -> effekt. Alle fire tiers skal vaere til stede, og ingen maa vaere tom (docs/04 afsnit 9).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failForward",
          "partialWithCost",
          "success",
          "criticalSuccess"
        ],
        "properties": {
          "failForward": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resourceDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "campDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "propertyNames": {
                  "enum": [
                    "shelterIntegrity",
                    "fireStrength",
                    "foodSecurity",
                    "signalProgress",
                    "campThreat"
                  ]
                }
              },
              "addTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removeTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fatigueCost": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "partialWithCost": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resourceDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "campDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "propertyNames": {
                  "enum": [
                    "shelterIntegrity",
                    "fireStrength",
                    "foodSecurity",
                    "signalProgress",
                    "campThreat"
                  ]
                }
              },
              "addTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removeTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fatigueCost": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "success": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resourceDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "campDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "propertyNames": {
                  "enum": [
                    "shelterIntegrity",
                    "fireStrength",
                    "foodSecurity",
                    "signalProgress",
                    "campThreat"
                  ]
                }
              },
              "addTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removeTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fatigueCost": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "criticalSuccess": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resourceDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "campDeltas": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "propertyNames": {
                  "enum": [
                    "shelterIntegrity",
                    "fireStrength",
                    "foodSecurity",
                    "signalProgress",
                    "campThreat"
                  ]
                }
              },
              "addTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removeTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fatigueCost": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "outcomeThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partial",
        "success",
        "critical"
      ],
      "description": "Taerskler for udfaldsformlen. Ligger i data, saa balancering ikke kraever rebuild.",
      "properties": {
        "partial": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "success": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critical": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Skader og traethed. Modstanden i udfaldsformlen udledes herfra af direktoren - klienten sender den ikke med.",
      "properties": {
        "maxFatiguePenalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "injuries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "penaltyContribution",
              "healedBy"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "penaltyContribution": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blocksActions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "healedBy": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
